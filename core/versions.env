# Слой 2 — ядро ComfyUI. Читают core/Containerfile (через --build-arg) и tools/comfy.

# На каком runtime собираем (тег из runtime/versions.env)
RUNTIME_IMAGE=localhost/strix-runtime:rocm7.15.0a20260721-torch2.14

# Откуда и что берём. COMFYUI_REF — тег (v0.35.1), ветка (master) или полный SHA коммита.
# Это ref по умолчанию для `tools/comfy build core`; другой передаётся аргументом.
COMFYUI_REPO=https://github.com/comfyanonymous/ComfyUI.git
COMFYUI_REF=v0.35.1

IMAGE=localhost/comfy-core
