# Слой 2 — ядро ComfyUI поверх runtime: код по тегу/коммиту, requirements, Manager, патчи ядра.
# Ноды, модели и данные сюда не входят (слой 3 и монтирования, ADR-0001/0003).
#
# Сборка: bash tools/comfy build core [REF]   → localhost/comfy-core:<REF>
# Сеть при сборке нужна: клон ComfyUI и пакеты с PyPI. torch с PyPI прийти не может —
# PIP_CONSTRAINT из runtime закрепляет весь стек torch/ROCm.

ARG RUNTIME_IMAGE=localhost/strix-runtime:latest
FROM ${RUNTIME_IMAGE}

ARG COMFYUI_REPO=https://github.com/comfyanonymous/ComfyUI.git
ARG COMFYUI_REF=v0.35.1

# Клон одного ref без истории; .git остаётся: по нему работают патчи (git apply) и Manager
# (в образе kyuz0 /opt/ComfyUI без .git, и Manager отказывался обновляться).
# fetch по имени работает для тега, ветки и полного SHA.
# safe.directory --system (не --global!): репозиторий собран от root, а контейнер
# запускается с --userns=keep-id от UID хоста — без системного исключения git
# в рантайме отказывает с "detected dubious ownership", и Manager видит
# "not a Git repository" вместо ревизии. --system пишет в /etc/gitconfig,
# он общий для любого UID; --global ушёл бы в /root, не в HOME хостового юзера.
RUN git config --system --add safe.directory /opt/ComfyUI \
    && git init -q /opt/ComfyUI \
    && cd /opt/ComfyUI \
    && git remote add origin "${COMFYUI_REPO}" \
    && git fetch -q --depth=1 origin "${COMFYUI_REF}" \
    && git checkout -q --detach FETCH_HEAD \
    && printf 'COMFYUI_REF=%s\nCOMFYUI_SHA=%s\nCOMFYUI_DATE=%s\n' \
         "${COMFYUI_REF}" "$(git rev-parse HEAD)" "$(git log -1 --format=%cs)" > /opt/comfy-core.env \
    && cat /opt/comfy-core.env && grep __version__ comfyui_version.py

# Патчи ядра (docs/patches-registry.md). Конфликт останавливает сборку;
# патч, уже принятый в upstream, только помечается в логе.
COPY core/patches/ /opt/patches/
COPY core/apply-patches.sh /opt/apply-patches.sh
RUN bash /opt/apply-patches.sh

WORKDIR /opt/ComfyUI

# Зависимости ядра и Manager. Без pip-кэша (PIP_NO_CACHE_DIR из runtime).
# После установки — контроль, что стек torch/ROCm остался ровно тем, что в /opt/constraints.txt.
# check-torch-stack.py, а не системный diff: в минимальном Fedora-runtime пакета diffutils
# нет, тянуть его в core-слой ради одной проверки лишнее. Сравнение по точному имени пакета,
# а не по префиксу "torch" — иначе совпадает и torchsde, обычная зависимость из requirements.txt.
COPY core/check-torch-stack.py /opt/check-torch-stack.py
RUN pip install -r requirements.txt -r manager_requirements.txt \
    && pip check \
    && python3 /opt/check-torch-stack.py

# Импорт ядра без GPU и без сервера: ловит сломанные зависимости ещё при сборке.
# Отдельный скрипт, а не python -c: нужно сперва включить args_parsing и
# подставить --cpu (как это делает main.py), иначе model_management при
# импорте лезет в torch.cuda, а у podman build устройств нет.
# PYTHONPATH=/opt/ComfyUI: sys.path[0] для `python /opt/…` — это /opt (папка
# скрипта), не WORKDIR, иначе "import comfy" не находит пакет.
COPY core/check-core-import.py /opt/check-core-import.py
RUN PYTHONPATH=/opt/ComfyUI python /opt/check-core-import.py

LABEL org.opencontainers.image.title="comfy-core" \
      org.opencontainers.image.version="${COMFYUI_REF}" \
      org.opencontainers.image.base.name="${RUNTIME_IMAGE}"

# Запуск задаёт tools/comfy: порт, --base-directory /data, --models-directory /models, ключи.
CMD ["python", "main.py", "--help"]
