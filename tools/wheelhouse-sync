#!/usr/bin/env bash
# Скачивает в var/wheelhouse все колёса стека torch/ROCm из runtime/versions.env
# (с зависимостями, sdist собираются в колёса). Повторный запуск докачивает только недостающее.
# Запуск внутри контейнера базового образа: на хосте нет Python 3.13, а колёса cp313.
#
#   bash tools/wheelhouse-sync
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck disable=SC1091
source "$ROOT/runtime/versions.env"

WH="$ROOT/var/wheelhouse"
mkdir -p "$WH"

# label=disable: var/ лежит на NTFS, SELinux-метки (:z) там не ставятся.
podman run --rm --security-opt label=disable \
    -v "$WH:/wheelhouse" \
    -e PIP_NO_CACHE_DIR=1 \
    "$BASE_IMAGE" bash -euo pipefail -c "
        dnf -y -q install --setopt=install_weak_deps=False --nodocs python${PYTHON} >/dev/null
        python${PYTHON} -m venv /tmp/venv
        /tmp/venv/bin/pip install -q --upgrade pip
        # --find-links первым: уже скачанное не тянется заново
        /tmp/venv/bin/pip wheel --wheel-dir /wheelhouse --find-links /wheelhouse \
            --index-url '${WHEEL_INDEX}' --extra-index-url https://pypi.org/simple --pre \
            'torch[device-${GFX}]==${TORCH_VERSION}' \
            'torchvision[device-${GFX}]==${TORCHVISION_VERSION}' \
            'torchaudio==${TORCHAUDIO_VERSION}' \
            'triton==${TRITON_VERSION}' \
            pip setuptools wheel
    "

echo "--- var/wheelhouse: $(ls "$WH" | wc -l) файлов, $(du -sh "$WH" | cut -f1)"
