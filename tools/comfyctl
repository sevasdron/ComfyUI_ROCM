#!/usr/bin/env bash
# Управление нашей сборкой с рабочего стола (аналог ~/bin/comfyctl для старого toolbox).
#   bash tools/comfyctl start | stop | restart | status | log
# Контейнер comfy-<NAME> из tools/comfy. NAME — модпак (по умолчанию main): порт, ключи и Manager
# берутся из modpacks/<NAME>/modpack.yaml, образ comfy-<NAME>:stable. COMFY_NAME=core — голое ядро на 8100.
set -uo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
NAME=${COMFY_NAME:-main}
if [ -f "$ROOT/modpacks/$NAME/modpack.yaml" ]; then
    eval "$(python3 "$ROOT/tools/modpack.py" env "$NAME")"
    PORT=${COMFY_PORT:-$MP_PORT}
    RUN_OPTS=(--port "$PORT")
else
    PORT=${COMFY_PORT:-8100}
    RUN_OPTS=(--port "$PORT" --manager)
fi
URL="http://127.0.0.1:$PORT"
TIMEOUT=240
# Интерфейс открываем как установленное PWA-приложение Chrome (ярлык ComfyUIROCM на рабочем столе),
# а не вкладкой. Id приложения — от start_url http://127.0.0.1:8100; COMFY_APP_ID= (пусто) → обычная вкладка.
CHROME=/opt/google/chrome/google-chrome
APP_ID=${COMFY_APP_ID-bdacbacgnmngpoplcdfnfinlmdmaceek}

open_ui() {
    if [ -n "$APP_ID" ] && [ -x "$CHROME" ]; then
        setsid "$CHROME" --profile-directory=Default --app-id="$APP_ID" >/dev/null 2>&1 < /dev/null &
    else
        xdg-open "$URL" >/dev/null 2>&1 &
    fi
}

msg() { echo "$*"; command -v notify-send >/dev/null && notify-send -a "ComfyUI ROCm Halo" "ComfyUI ROCm Halo" "$*"; }
port_up() { curl -fs "$URL/system_stats" >/dev/null 2>&1; }
running() { podman container exists "comfy-$NAME" 2>/dev/null && [ "$(podman inspect -f '{{.State.Running}}' "comfy-$NAME")" = true ]; }

do_start() {
    if port_up; then msg "Уже работает — открываю $URL"; open_ui; return 0; fi
    running || podman container exists "comfy-$NAME" && bash "$ROOT/tools/comfy" stop "$NAME" >/dev/null 2>&1
    bash "$ROOT/tools/comfy" run "$NAME" "${RUN_OPTS[@]}" || { msg "Не смог запустить контейнер comfy-$NAME"; return 1; }
    for ((i = 0; i < TIMEOUT; i++)); do
        port_up && { msg "ComfyUI ROCm Halo поднялся на $URL"; open_ui; return 0; }
        running || break
        sleep 1
    done
    msg "ComfyUI ROCm Halo не поднялся за ${TIMEOUT}с — лог: bash tools/comfyctl log"
    return 1
}

do_stop() {
    if ! podman container exists "comfy-$NAME" 2>/dev/null; then msg "ComfyUI ROCm Halo уже остановлен"; return 0; fi
    bash "$ROOT/tools/comfy" stop "$NAME" >/dev/null 2>&1 && msg "ComfyUI ROCm Halo остановлен" || { msg "Не смог остановить comfy-$NAME"; return 1; }
}

case "${1:-}" in
    start)   do_start ;;
    stop)    do_stop ;;
    restart) do_stop; do_start ;;
    status)  bash "$ROOT/tools/comfy" status; port_up && echo "порт $PORT: слушает → $URL" || echo "порт $PORT: свободен" ;;
    log)     bash "$ROOT/tools/comfy" log "$NAME" "${@:2}" ;;
    *) echo "usage: comfyctl start|stop|restart|status|log"; exit 1 ;;
esac
