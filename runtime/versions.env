# Версии слоя runtime. Единственный источник правды: отсюда читают
# runtime/Containerfile (через --build-arg), tools/wheelhouse-sync и tools/runtime-build.
#
# Источник версий: образ docker.io/kyuz0/amd-strix-halo-comfyui:latest
# (digest sha256:384aa1fe…, собран 11.08.2026), проверен в работе на gfx1151.
# Линейка rocm 7.15 на индексе AMD закончилась 28.07.2026 (дальше идёт rocm 10.x),
# поэтому колёса обязательно лежат в var/wheelhouse (tools/wheelhouse-sync).

# ОС и Python (ADR-0004: стабильная Fedora, совпадает с хостом)
BASE_IMAGE=registry.fedoraproject.org/fedora:44
PYTHON=3.13
GFX=gfx1151

# Индекс колёс AMD (multi-arch: torch + rocm-sdk как pip-пакеты)
WHEEL_INDEX=https://rocm.nightlies.amd.com/whl-multi-arch/

# Стек torch/ROCm. torchaudio 2.11.0.2 для сборки 0721 не существует — только 0725..0728,
# kyuz0 получил 0728; закрепляем то же.
ROCM_VERSION=7.15.0a20260721
TORCH_VERSION=2.14.0a0+rocm7.15.0a20260721
TORCHVISION_VERSION=0.29.0a0+rocm7.15.0a20260721
TORCHAUDIO_VERSION=2.11.0.2+rocm7.15.0a20260728
TRITON_VERSION=3.8.0+git4774139f.rocm7.15.0a20260721

# Имя и тег результата
IMAGE=localhost/strix-runtime
TAG=rocm7.15.0a20260721-torch2.14
