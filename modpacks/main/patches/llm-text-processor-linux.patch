+def _local_cli() -> LlamaCliPaths | None:
+    override = os.environ.get(LOCAL_CLI_ENV)
+    if override:
+        cli = Path(override).expanduser()
+        if not cli.is_file():
+            raise RuntimeError(f"{LOCAL_CLI_ENV} points to a missing file: {cli}")
+        return LlamaCliPaths(cli=cli)
